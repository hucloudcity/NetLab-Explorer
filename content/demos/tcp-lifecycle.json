          "traceRow": {
            "time": "0.000",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "TCP",
            "info": "49152 → 80 [SYN] Seq=0",
            "size": 66,
            "cat": "hand",
            "eventRef": "e01"
          }
        },
        {
          "id": "syn-ack",
          "title": "同步并确认",
          "caption": "服务器 TCP 栈回应 SYN+ACK：确认对方的 Seq=0（Ack=1），同时带上自己的初始序列号，进入 SYN_RCVD。此时连接资源已分配，处于半连接状态。",
          "description": "Ack=1 的含义不是\"收到 1 个字节\"，而是\"我期待下一个字节序号是 1\"——即 Seq=0 那个 SYN 已收到。服务器此时把连接放进半连接队列：资源已分配，但握手未完成。这个不对称状态正是 SYN Flood 攻击的目标，Linux 的 syncookies 让内核在这种压力下不分配资源也能回应。",
          "events": [
            {
              "id": "e02",
              "kind": "unicast",
              "from": "server",
              "to": {
                "kind": "device",
                "id": "client"
              },
              "payload": {
                "proto": "TCP",
                "summary": "SYN+ACK Seq=0 Ack=1",
                "size": 66,
                "cat": "hand"
              },
              "dependsOn": [
                "e01"
              ],
              "note": "半连接队列"
            }
          ],
          "stateDeltas": [
            {
              "id": "d02",
              "device": "server",
              "afterEvent": "e02",
              "changes": [
                {
                  "table": "tcp-state",
                  "op": "set",
                  "entry": {
                    "peer": "client",
                    "from": "LISTEN",
                    "to": "SYN_RCVD"
                  }
                }
              ]
            }
          ],
          "traceRow": {
            "time": "0.017",
            "src": "203.0.113.10",
            "dst": "192.168.1.10",
            "proto": "TCP",
            "info": "80 → 49152 [SYN, ACK] Seq=0 Ack=1",
            "size": 66,
            "cat": "hand",
            "eventRef": "e02"
          }
        },
        {
          "id": "ack",
          "title": "最终确认，连接建立",
          "caption": "客户端回最后一个 ACK，双方进入 ESTABLISHED。三次交互让双方都验证了双向收发能力，连接正式就绪，可以开始传数据。",
          "description": "第三次握手是唯一能携带应用数据的一次（TCP Fast Open 就利用这一点）。为什么不能两次握手就建立连接：若网络里一个陈旧的 SYN 迟到，两次握手的服务器会直接建立连接；有了第三次确认，服务器只有收到 ACK 才正式就绪，陈旧请求会被拒绝。",
          "events": [
            {
              "id": "e03",
              "kind": "unicast",
              "from": "client",
              "to": {
                "kind": "device",
                "id": "server"
              },
              "payload": {
                "proto": "TCP",
                "summary": "ACK Seq=1 Ack=1",
                "size": 60,
                "cat": "hand"
              },
              "dependsOn": [
                "e02"
              ],
              "note": "连接就绪"
            }
          ],
          "stateDeltas": [
            {
              "id": "d03",
              "device": "client",
              "afterEvent": "e03",
              "changes": [
                {
                  "table": "tcp-state",
                  "op": "set",
                  "entry": {
                    "peer": "server",
                    "from": "SYN_SENT",
                    "to": "ESTABLISHED"
                  }
                }
              ]
            },
            {
              "id": "d03b",
              "device": "server",
              "afterEvent": "e03",
              "changes": [
                {
                  "table": "tcp-state",
                  "op": "set",
                  "entry": {
                    "peer": "client",
                    "from": "SYN_RCVD",
                    "to": "ESTABLISHED"
                  }
                }
              ]
            }
          ],
          "traceRow": {
            "time": "0.034",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "TCP",
            "info": "49152 → 80 [ACK] Seq=1 Ack=1",
            "size": 60,
            "cat": "hand",
            "eventRef": "e03"
          }
