              "id": "e09",
              "kind": "unicast",
              "from": "server",
              "to": {
                "kind": "device",
                "id": "client"
              },
              "payload": {
                "proto": "TCP",
                "summary": "TCP Retransmission Seq=1 Ack=79 Len=1460",
                "size": 1514,
                "cat": "sdata"
              },
              "dependsOn": [
                "e08"
              ],
              "note": "重传分段发出"
            }
          ],
          "stateDeltas": [],
          "traceRow": {
            "time": "0.095",
            "src": "203.0.113.10",
            "dst": "192.168.1.10",
            "proto": "TCP",
            "info": "80 → 49152 [TCP Retransmission] Seq=1 Ack=79 Len=1460",
            "size": 1514,
            "cat": "sdata",
            "eventRef": "e09"
          }
        },
