            "src": "203.0.113.10",
            "dst": "192.168.1.10",
            "proto": "TCP",
            "info": "80 → 49152 [ACK] Seq=1 Ack=79",
            "size": 60,
            "cat": "hand",
            "eventRef": "e05"
          }
