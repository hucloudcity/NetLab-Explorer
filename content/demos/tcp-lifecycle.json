          "stateDeltas": [],
          "traceRow": {
            "time": "0.034",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "TCP",
            "info": "49152 → 80 [PSH, ACK] Seq=1 Ack=1 Len=78",
            "size": 132,
            "cat": "cdata",
            "eventRef": "e04"
          }
        },
        {
          "id": "ack-request",
          "title": "服务端确认请求",
          "caption": "服务器确认收到请求（Ack=79 = 1+78），随后组织响应数据，按 MSS≈1460 字节分成多个分段依次发送。",
          "description": "确认号 79 = 1 + 78：累积确认把\"到目前为止连续收到的最后一个字节\"作为确认点。真实实现里 ACK 通常会延迟几十毫秒（delayed ACK），等有机会时捎带在反向数据里发送，减少纯 ACK 报文的数量——表格里这类 60 B 的纯 ACK 就是最\"贵\"的报文：只花带宽不做事。",
          "events": [
